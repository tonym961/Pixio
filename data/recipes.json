{
  "_doc": "Ricette di boot Pixio. Ordine di valutazione: priority crescente. 'files' = candidati (case-insensitive) risolti al rilevamento; 'require' = chiavi che devono esistere; 'markers_any'/'markers_all' = percorsi aggiuntivi. Nello script: {http_iso} {http_isofile} {http_boot} {http_inject} {server_ip} {slug} {f:chiave} (percorso risolto) {fn:chiave} (solo nome file). Righe con prefisso '?flag ' o '?!flag ' sono condizionali (flag: smb_export).",
  "types": [
    {
      "id": "windows",
      "name": "Installazione Windows",
      "category": "os",
      "platforms": [
        "bios",
        "efi"
      ],
      "priority": 10,
      "files": {
        "bootwim": [
          "sources/boot.wim"
        ],
        "bcd": [
          "boot/bcd"
        ],
        "bootsdi": [
          "boot/boot.sdi"
        ],
        "install": [
          "sources/install.wim",
          "sources/install.esd",
          "sources/install*.swm"
        ]
      },
      "require": [
        "bootwim",
        "bcd",
        "bootsdi",
        "install"
      ],
      "script": [
        "kernel {http_boot}/wimboot",
        "?inject initrd http://{server_ip}/boot/inject/{slug}/winpeshl.ini winpeshl.ini",
        "?inject initrd http://{server_ip}/boot/inject/{slug}/install.cmd install.cmd",
        "{drivers}",
        "initrd {http_iso}/{f:bcd} BCD",
        "initrd {http_iso}/{f:bootsdi} boot.sdi",
        "initrd {http_iso}/{f:bootwim} boot.wim",
        "boot"
      ],
      "warnings_if": {
        "!smb_export": "Senza 'Installazione Windows via rete' attiva (Impostazioni) il setup parte ma non trova install.wim: dovrai mappare una share a mano da WinPE (Shift+F10, net use)."
      },
      "notes": "wimboot carica BCD, boot.sdi e boot.wim via HTTP. winpeshl.ini/install.cmd (generati da Pixio) caricano i driver iniettati con drvload, mappano \\\\server\\pxe e lanciano setup.exe.",
      "warnings": [
        "Secure Boot deve essere disattivato sul PC (iPXE non è firmato). RAM >= 2 GB. Il PC installa in modalità UEFI o BIOS a seconda di come ha fatto il boot PXE."
      ]
    },
    {
      "id": "winpe-tool",
      "name": "WinPE (strumento)",
      "category": "tool",
      "platforms": [
        "bios",
        "efi"
      ],
      "priority": 15,
      "files": {
        "bootwim": [
          "sources/boot.wim",
          "boot.wim",
          "sstr/strelec*.wim",
          "hbcd_pe_x64.wim",
          "hbcd_pe.wim",
          "medicat.wim",
          "*.wim"
        ],
        "bcd": [
          "boot/bcd",
          "sstr/bcd",
          "efi/microsoft/boot/bcd"
        ],
        "bootsdi": [
          "boot/boot.sdi",
          "sstr/boot.sdi",
          "efi/microsoft/boot/boot.sdi"
        ]
      },
      "require": [
        "bootwim",
        "bcd",
        "bootsdi"
      ],
      "script": [
        "kernel {http_boot}/wimboot",
        "initrd {http_iso}/{f:bcd} BCD",
        "initrd {http_iso}/{f:bootsdi} boot.sdi",
        "initrd {http_iso}/{f:bootwim} boot.wim",
        "boot"
      ],
      "notes": "Hiren's BootCD PE (completo), Strelec/Medicat (solo PE base: i programmi sono fuori dal wim). Il .wim va tutto in RAM: servono >= 4 GB."
    },
    {
      "id": "clonezilla",
      "name": "Clonezilla live",
      "category": "tool",
      "platforms": [
        "bios",
        "efi"
      ],
      "priority": 20,
      "files": {
        "kernel": [
          "live/vmlinuz"
        ],
        "initrd": [
          "live/initrd.img"
        ],
        "squashfs": [
          "live/filesystem.squashfs"
        ]
      },
      "require": [
        "kernel",
        "initrd",
        "squashfs"
      ],
      "markers_any": [
        "clonezilla-live-version"
      ],
      "script": [
        "kernel {http_iso}/{f:kernel} initrd={fn:initrd} boot=live union=overlay username=user config components quiet noswap edd=on nomodeset nodmraid locales=it_IT.UTF-8 keyboard-layouts=it ocs_live_run=\"ocs-live-general\" ocs_live_extra_param=\"\" ocs_live_batch=\"no\" net.ifnames=0 nosplash noprompt ip=dhcp fetch={http_iso}/{f:squashfs}",
        "initrd {http_iso}/{f:initrd}",
        "boot"
      ]
    },
    {
