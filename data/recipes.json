    {
      "id": "winpe-tool",
      "name": "WinPE (strumento)",
      "category": "tool",
      "platforms": [
        "bios",
        "efi"
      ],
      "priority": 15,
      "files": {
        "bootwim": [
          "sources/boot.wim",
