      "script": [
        "kernel {http_iso}/{f:kernel} initrd={fn:initrd} vga=788 --- quiet",
        "initrd {http_iso}/{f:initrd}",
        "boot"
      ],
      "warnings": [
        "L'initrd della ISO cerca un CD-ROM: se l'installer si ferma su 'rilevamento CD', usa la ricetta netboot (Pixio scarica kernel e initrd netboot ufficiali se c'è internet)."
      ]
    },
