          "boot/bcd",
          "sstr/bcd",
          "efi/microsoft/boot/bcd"
        ],
        "bootsdi": [
          "boot/boot.sdi",
          "sstr/boot.sdi",
          "efi/microsoft/boot/boot.sdi"
        ]
      },
      "require": [
        "bootwim",
        "bcd",
        "bootsdi"
      ],
      "script": [
        "kernel {http_boot}/wimboot",
        "{drivers}",
        "initrd {http_iso}/{f:bcd} BCD",
