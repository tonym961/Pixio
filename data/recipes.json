      "script": [
        "kernel {http_iso}/{f:kernel} initrd=initrd.magic boot=live union=overlay username=user config components loglevel=3 noswap edd=on nomodeset enforcing=0 noeject locales=it_IT.UTF-8 keyboard-layouts=it ocs_live_run=\"ocs-live-general\" ocs_live_extra_param=\"\" ocs_live_batch=\"no\" vga=788 net.ifnames=0 ip=dhcp nosplash fetch={http_iso}/{f:squashfs}",
        "initrd {http_iso}/{f:initrd}",
        "boot"
      ],
      "warnings": [
        "Il filesystem live (circa 500 MB) viene scaricato in RAM: servono almeno 1,5 GB sul PC."
      ],
      "notes": "Riga di comando presa dal syslinux.cfg della ISO 3.3.3, con lingua e tastiera italiane.",
      "group": "Strumenti"
    },
